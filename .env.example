# Smart Task Manager Configuration Example
# Copy this file to .env and fill in your values

# Google Gemini API Key (Optional for basic task management, required for AI suggestions)
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g. gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Database URL (Default: SQLite file in data/)
DATABASE_URL=sqlite:///./data/tasks.db

# Server Ports
API_HOST=127.0.0.1
API_PORT=8000
UI_PORT=8501

# App Environment (development, testing, production)
ENVIRONMENT=development
LOG_LEVEL=INFO
